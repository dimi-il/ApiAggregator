{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Aggregation": {
    "CacheDuration": "00:02:00",
    "StaleDuration": "01:00:00"
  },

  "Anomaly": {
    "CheckInterval": "00:01:00",
    "Window": "00:05:00",
    "ThresholdRatio": 1.5,
    "MinSamples": 3
  }
}
